{
  "name": "cristofer-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun run typecheck && bun --bun vite build",
    "build:html": "bun run typecheck && bun --bun vite build --mode standalone && bun scripts/verify-standalone.ts",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "typecheck": "bun --bun tsc -b",
    "lint": "bun --bun eslint . --max-warnings 0",
    "lint:fix": "bun --bun eslint . --fix --max-warnings 0",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "gsap": "3.15.1",
    "lenis": "1.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.33",
    "prettier": "^3.6.2",
    "rollup": "^4.59.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^4.0.0"
  }
}
